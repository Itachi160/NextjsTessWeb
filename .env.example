# =================================================================
# Tesseract InfoSystems Environment Configuration
# =================================================================

# 1. Google Gemini API (For AI Features)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Instant Email Delivery via SMTP (Recommended for 100% Reliable Delivery)
# If configured, submissions to the contact form are dispatched immediately
# directly to info@tesseractinfosystems.com with zero reliance on 3rd party relays.

# Example for Google Workspace / Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=info@tesseractinfosystems.com
# SMTP_PASS=your_16_character_google_app_password

# Example for Titan Email / Hostinger / cPanel:
# SMTP_HOST=smtp.titan.email
# SMTP_PORT=465
# SMTP_USER=info@tesseractinfosystems.com
# SMTP_PASS=your_email_account_password

# Example for Zoho Mail:
# SMTP_HOST=smtp.zoho.com
# SMTP_PORT=465
# SMTP_USER=info@tesseractinfosystems.com
# SMTP_PASS=your_zoho_app_password
